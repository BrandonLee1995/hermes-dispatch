HERMES_IMAGE=nousresearch/hermes-agent:latest
HERMES_DATA_DIR=/home/marvel/.hermes
HERMES_UID=1000
HERMES_GID=1000

DASHBOARD_USER=marvel
DASHBOARD_PASSWORD=<dashboard-password>
DASHBOARD_SECRET=<long-random-dashboard-secret>
API_SERVER_KEY=<long-random-api-key>
MCP_BEARER_TOKEN=<long-random-mcp-token>
CLOUDFLARED_TOKEN=<cloudflare-tunnel-token>

API_PORT=8642
DASHBOARD_PORT=9119
MCP_HTTP_PORT=8765
HERMES_MEM_LIMIT=3g
HERMES_CPUS=1.5
HERMES_MCP_ENABLE_QQBOT_HOTFIX=1
