HERMES_MCP_PROJECT_NAME=hermes-mcp-http-example
HERMES_MCP_CONTAINER_NAME=hermes-mcp-http-example
HERMES_MCP_CADDY_CONTAINER_NAME=hermes-mcp-caddy-example

HERMES_IMAGE=nousresearch/hermes-agent:latest
HERMES_MCP_DATA_DIR=/public/hermes/example-dept
HERMES_MCP_ENV_FILE=/public/hermes/example-dept/.env

HERMES_MCP_HTTP_HOST=127.0.0.1
HERMES_MCP_HTTP_PORT=8765
HERMES_MCP_HTTP_PATH=/mcp
HERMES_MCP_HTTP_BEARER_TOKEN=change-this-to-a-long-random-token

HERMES_MCP_PUBLIC_SITE=http://example-dept-mcp.hermes.lan:18080
HERMES_MCP_PROXY_BIND=127.0.0.1
HERMES_MCP_UPSTREAM=127.0.0.1:8765
HERMES_MCP_CADDYFILE=./caddy-hermes-lan.Caddyfile

HERMES_MCP_ENABLE_QQBOT_HOTFIX=0
